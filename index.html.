<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#12224B">
<title>نِمبار | Nimbar</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Readex+Pro:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{--navy:#12224B;--navy-d:#0A1533;--navy-m:#2B3F78;--mist:#F2F5FB;--tint:#E6ECF8;--line:#DCE3F0;--muted:#586789;--white:#fff;--ok:#1F7A57;--bad:#A63D40;--r:14px;--nav-h:68px}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--white);color:var(--navy-d);font-family:'IBM Plex Sans Arabic',system-ui,sans-serif;font-size:15px;line-height:1.75;padding-bottom:calc(var(--nav-h) + env(safe-area-inset-bottom))}
h1,h2,h3{font-family:'Readex Pro','IBM Plex Sans Arabic',sans-serif;margin:0;line-height:1.35;color:var(--navy)}
p{margin:0}button,input,textarea,select{font:inherit;color:inherit}button{cursor:pointer}a{color:inherit}
.hidden{display:none!important}
.wrap{width:min(1080px,100% - 32px);margin-inline:auto}
:focus-visible{outline:3px solid var(--navy-m);outline-offset:2px;border-radius:6px}

/* ---------- header ---------- */
header.top{position:sticky;top:0;z-index:30;background:#fffffff2;backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.top-in{height:62px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none}
.brand img{height:40px;width:auto}
.brand b{font-family:'Readex Pro',sans-serif;font-size:20px;color:var(--navy);letter-spacing:0}
.deskNav{display:none;gap:4px}
.deskNav a{display:flex;align-items:center;gap:8px;padding:8px 15px;border-radius:999px;text-decoration:none;font-weight:500;color:var(--muted);transition:background .2s,color .2s}
.deskNav a:hover{background:var(--mist);color:var(--navy)}
.deskNav a.on{background:var(--navy);color:#fff}
.deskNav svg,.tabbar svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
.bell{position:relative;width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:#fff;display:grid;place-items:center;color:var(--navy)}
.bell svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.bell i{position:absolute;top:-3px;inset-inline-start:-3px;min-width:19px;height:19px;border-radius:999px;background:var(--navy);color:#fff;font:600 11px/19px 'IBM Plex Sans Arabic';text-align:center;font-style:normal;border:2px solid #fff;padding:0 3px}

/* ---------- bottom tab bar ---------- */
.tabbar{position:fixed;inset-inline:0;bottom:0;z-index:40;background:#fff;border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(5,1fr);padding:6px 6px calc(6px + env(safe-area-inset-bottom))}
.tabbar a{display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 2px;text-decoration:none;font-size:11.5px;font-weight:500;color:var(--muted);border-radius:12px}
.tabbar a.on{color:var(--navy);font-weight:600}
.tabbar a.on svg{background:var(--navy);color:#fff;width:46px;height:28px;padding:4px 13px;border-radius:999px;stroke-width:2}
.tabbar a:not(.on) svg{height:28px;padding:4px 0}

/* ---------- hero ---------- */
.hero{background:var(--navy);color:#fff;position:relative;overflow:hidden}
.hero .palm{position:absolute;height:130%;inset-inline-end:-6%;bottom:-18%;opacity:.13;pointer-events:none;animation:rise 1.1s cubic-bezier(.2,.7,.2,1) both}
@keyframes rise{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:.13}}
.hero-in{position:relative;padding:44px 0 52px;max-width:640px}
.hero h1{color:#fff;font-size:clamp(34px,8.5vw,58px);font-weight:700;line-height:1.25}
.hero p{margin-top:14px;color:#C9D4EE;max-width:46ch;font-size:16px}
.hero .go{margin-top:26px;display:flex;flex-wrap:wrap;align-items:center;gap:16px}
.hero .count{color:#C9D4EE;font-size:14px}.hero .count b{color:#fff;font-family:'Readex Pro';font-size:22px;margin-inline-end:6px}
.slogan{margin-top:22px;font-size:13px;color:#9FB0D8}

/* ---------- controls ---------- */
.btn{white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid var(--navy);background:#fff;color:var(--navy);padding:10px 18px;border-radius:10px;font-weight:600;font-size:14px;text-decoration:none;transition:background .2s,color .2s,transform .15s}
.btn:hover{background:var(--tint)}.btn:active{transform:scale(.98)}
.btn.solid{background:var(--navy);color:#fff}.btn.solid:hover{background:var(--navy-m)}
.btn.light{background:#fff;color:var(--navy);border-color:#fff}.btn.light:hover{background:var(--tint)}
.btn.sm{padding:6px 12px;font-size:13px}.btn.block{width:100%}
.btn.del{color:var(--bad);border-color:#E9C9CA}.btn.del:hover{background:#FBF0F0}
.btn:disabled{opacity:.55;cursor:not-allowed}
.field{margin-bottom:14px}.field label{display:block;font-weight:600;font-size:13px;margin-bottom:6px;color:var(--navy)}
input,textarea,select{width:100%;border:1px solid var(--line);background:#fff;border-radius:10px;padding:11px 13px;font-size:15px}
input:focus,textarea:focus,select:focus{outline:2px solid var(--navy-m);border-color:var(--navy-m)}
textarea{min-height:96px;resize:vertical}
.ltr{direction:ltr;text-align:left}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:#fff;border-radius:999px;padding:7px 18px;font-weight:600;font-size:14px;color:var(--muted)}
.chip.on{background:var(--navy);border-color:var(--navy);color:#fff}
.status{padding:11px 14px;border-radius:10px;font-size:14px;margin-bottom:14px;background:var(--tint);color:var(--navy)}
.status.ok{background:#E7F5EE;color:var(--ok)}.status.error{background:#FBEDED;color:var(--bad)}

/* ---------- sections ---------- */
.view{padding:28px 0 36px}
.view-head{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:14px;margin-bottom:20px}
.view-head h2{font-size:clamp(24px,5vw,32px)}.view-head p{color:var(--muted);margin-top:4px}
.search{display:flex;gap:8px;min-width:min(100%,320px)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:16px}
.card{border:1px solid var(--line);border-radius:var(--r);padding:20px;background:#fff;display:flex;flex-direction:column;gap:10px;transition:border-color .2s,transform .2s}
.card:hover{border-color:var(--navy-m);transform:translateY(-2px)}
.card h3{font-size:18px}.card p{color:var(--muted);font-size:14.5px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.card .meta{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:13px;color:var(--muted)}
.card .foot{margin-top:auto;padding-top:6px}
.card img.cover{width:100%;height:150px;object-fit:cover;border-radius:10px}
.tag{display:inline-block;padding:2px 12px;border-radius:999px;font-size:12.5px;font-weight:600;border:1px solid var(--navy);color:var(--navy)}
.tag.fill{background:var(--navy);color:#fff}
.late{opacity:.6}
.empty{grid-column:1/-1;text-align:center;color:var(--muted);padding:44px 12px;border:1px dashed var(--line);border-radius:var(--r)}
.pinned{display:flex;gap:16px;align-items:center;border:1px solid var(--line);background:var(--mist);border-radius:var(--r);padding:14px 16px;margin-bottom:22px;text-decoration:none}
.pinned img{width:72px;height:72px;border-radius:10px;object-fit:cover;flex:none}
.pinned b{font-family:'Readex Pro';color:var(--navy)}.pinned span{display:block;color:var(--muted);font-size:14px}

/* ---------- certificates ---------- */
.cert-box{max-width:520px;margin:0 auto;text-align:center}
.cert-box>img.mark{height:84px;margin-bottom:10px}
.cert-box h2{font-size:28px}.cert-box>p{color:var(--muted);margin:8px 0 22px}
.cert-form{display:flex;gap:8px}
.cert-form input{font-family:ui-monospace,Menlo,monospace;font-size:18px;letter-spacing:2px;text-transform:uppercase;text-align:center;direction:ltr}
.cert-out{margin-top:24px;border:1px solid var(--line);border-radius:var(--r);padding:16px;text-align:center}
.cert-out img{width:100%;border-radius:8px;border:1px solid var(--line)}
.cert-out h3{margin:14px 0 4px;font-size:20px}.cert-out .row{display:flex;gap:8px;justify-content:center;margin-top:14px;flex-wrap:wrap}

/* ---------- account ---------- */
.acc{max-width:560px;margin:0 auto;display:grid;gap:18px}
.panel{border:1px solid var(--line);border-radius:var(--r);padding:20px}
.panel h3{font-size:16px;margin-bottom:14px}
.who{display:flex;align-items:center;gap:14px;margin-bottom:16px}
.avatar{width:56px;height:56px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font:700 22px 'Readex Pro'}
.who small{color:var(--muted);display:block}
.seg{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:10px;overflow:hidden}
.seg button{border:0;background:#fff;padding:10px;font-weight:600;color:var(--muted)}
.seg button.on{background:var(--navy);color:#fff}
.btnrow{display:flex;gap:10px;flex-wrap:wrap}
.about{background:var(--mist);border-radius:var(--r);padding:22px;display:flex;gap:16px;align-items:center}
.about img{height:64px}.about p{color:var(--muted);font-size:14px}

/* ---------- modal / sheet ---------- */
.overlay{position:fixed;inset:0;background:#0A153399;z-index:60;display:none;align-items:flex-end;justify-content:center;padding:0}
.overlay.show{display:flex;animation:fade .2s}
@keyframes fade{from{opacity:0}}
.modal{background:#fff;width:min(560px,100%);max-height:88vh;overflow:auto;border-radius:20px 20px 0 0;padding:22px;animation:up .28s cubic-bezier(.2,.8,.2,1)}
@keyframes up{from{transform:translateY(30px);opacity:0}}
.modal-h{display:flex;justify-content:space-between;align-items:start;gap:12px;margin-bottom:14px}.modal-h h2{font-size:21px}
.x{border:1px solid var(--line);background:#fff;width:36px;height:36px;border-radius:50%;font-size:20px;line-height:1;flex:none}
.note-item{padding:14px 0;border-bottom:1px solid var(--line)}.note-item:last-child{border:0}
.note-item b{font-family:'Readex Pro';color:var(--navy);display:block}.note-item p{color:var(--muted);font-size:14px}.note-item small{color:var(--muted)}
.note-item.new b:before{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--navy);margin-inline-end:8px}
.switch{margin-top:14px;text-align:center;color:var(--muted);font-size:14px}.switch button{border:0;background:none;color:var(--navy);font-weight:600;text-decoration:underline}
.toast{position:fixed;inset-inline:16px;bottom:calc(var(--nav-h) + 16px + env(safe-area-inset-bottom));z-index:80;margin:auto;width:fit-content;max-width:100%;background:var(--navy);color:#fff;padding:11px 18px;border-radius:12px;font-size:14px;animation:up .25s}

/* ---------- admin ---------- */
.atabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:8px;margin-bottom:18px;border-bottom:1px solid var(--line)}
.atabs button{border:0;background:none;padding:9px 16px;border-radius:999px;font-weight:600;color:var(--muted);white-space:nowrap}
.atabs button.on{background:var(--navy);color:#fff}
.two{display:grid;grid-template-columns:1fr;gap:0 14px}
.alist{margin-top:22px;display:grid;gap:10px}
.arow{border:1px solid var(--line);border-radius:12px;padding:12px 14px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.arow small{display:block;color:var(--muted)}.arow .act{display:flex;gap:6px;flex-wrap:wrap}
.drop{border:2px dashed var(--navy-m);border-radius:var(--r);padding:26px;text-align:center;background:var(--mist);cursor:pointer;display:block}
.drop b{font-family:'Readex Pro';color:var(--navy)}
.crow{display:grid;grid-template-columns:64px 1fr;gap:12px;align-items:center;border:1px solid var(--line);border-radius:12px;padding:10px}
.crow img{width:64px;height:64px;object-fit:cover;border-radius:8px;border:1px solid var(--line)}
.crow .code{font:600 14px ui-monospace,Menlo,monospace;color:var(--navy);direction:ltr;text-align:start;margin-top:4px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.crow input{padding:7px 10px}.crow.warn input{border-color:var(--bad)}
.pairs{width:100%;min-height:140px;font-family:ui-monospace,Menlo,monospace;font-size:14px;direction:rtl;line-height:1.9}
.bar{height:6px;background:var(--tint);border-radius:9px;overflow:hidden;margin:10px 0}.bar i{display:block;height:100%;background:var(--navy);width:0;transition:width .3s}
.newcode{background:var(--mist);border:1px solid var(--navy-m);border-radius:12px;padding:14px;margin:14px 0;direction:ltr;font:600 17px ui-monospace,Menlo,monospace;word-break:break-all}

footer{border-top:1px solid var(--line);padding:22px 0;color:var(--muted);font-size:13px;text-align:center}

@media(min-width:760px){.two{grid-template-columns:1fr 1fr}}
@media(min-width:900px){
 :root{--nav-h:0px}
 .tabbar{display:none}.deskNav{display:flex}
 .top-in{height:68px}
 .hero-in{padding:76px 0 84px}
 .overlay{align-items:center;padding:20px}.modal{border-radius:20px}
 .toast{bottom:24px}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}.hero .palm{opacity:.13}}
/* ===== v2 ===== */
.frows{display:grid;gap:10px;margin-bottom:18px}
.card.oc{padding:0;overflow:hidden;cursor:pointer;gap:0}
.ocover{position:relative;height:170px;background:var(--mist);display:grid;place-items:center;border-bottom:1px solid var(--line)}
.ocover img{width:100%;height:100%;object-fit:cover}
.ocover img.dflt{width:116px;height:116px;border-radius:50%;border:3px solid #fff}
.heart{position:absolute;top:12px;inset-inline-start:12px;width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:var(--white);color:var(--muted);font-size:18px;display:grid;place-items:center;padding:0}
.heart.on{color:#e04b5f}
.obody{padding:16px 18px 18px;display:flex;flex-direction:column;gap:8px}
.tags{display:flex;gap:6px;flex-wrap:wrap}
.tg{display:inline-block;padding:2px 12px;border-radius:999px;font-size:12.5px;font-weight:600;border:1px solid var(--line);background:var(--mist);color:var(--navy-d)}
.tg.s-open{color:#2e9a6e;border-color:#2e9a6e55;background:#2e9a6e1f}.tg.s-soon{color:#c9a13c;border-color:#c9a13c55;background:#c9a13c1f}.tg.s-closed{color:#d0626a;border-color:#d0626a55;background:#d0626a1f}.tg.pin{color:#c9a13c}
.ometa{display:flex;gap:14px;flex-wrap:wrap;color:var(--muted);font-size:13px}
.dcover{width:100%;max-height:260px;object-fit:cover;border-radius:12px}
.bimg{width:100%;border-radius:12px;margin:10px 0}
.card[data-res]{cursor:pointer}
.chlist{display:flex;gap:10px;flex-wrap:wrap}
.chan{display:flex;align-items:center;gap:10px;border:1px solid var(--line);background:var(--mist);border-radius:14px;padding:12px 18px;text-decoration:none;font-weight:600}
.imgprev img{max-width:100%;max-height:150px;border-radius:10px;margin:6px 0;display:block}
.blk{border:1px dashed var(--line);border-radius:12px;padding:10px;margin-bottom:8px;display:grid;gap:8px}
.qrow{display:flex;gap:8px;margin-bottom:8px}
.field label.btn{display:inline-flex;margin:0;font-size:13px}
.note-item .btn{display:inline-flex}
.note-item.k-accepted{background:linear-gradient(135deg,#c9a13c26,#e04b5f1a);border-radius:12px;padding:14px;margin-bottom:8px;border:1px solid #c9a13c55}
.balloons{position:fixed;inset:0;z-index:90;pointer-events:none;overflow:hidden}
.balloons i{position:absolute;bottom:-90px;border-radius:50% 50% 48% 48%;animation:fly linear forwards;opacity:.92}
@keyframes fly{to{transform:translateY(-120vh) rotate(8deg)}}
html[data-theme=navy]{color-scheme:dark;--white:#0F1B3F;--mist:#16264F;--tint:#1E3068;--line:#2B3D72;--muted:#A9B8DD;--navy:#F2F5FF;--navy-d:#F2F5FF;--navy-m:#C8A95F;--gold:#C8A95F}
html[data-theme=navy] body{background:#0B1530}
html[data-theme=navy] header.top{background:#0B1530f2}
html[data-theme=navy] :is(.bell,.tabbar,.btn,.chip,.card,.modal,.x,.seg button,input,textarea,select){background:var(--white)}
html[data-theme=navy] .btn:hover{background:var(--tint)}
html[data-theme=navy] :is(.btn.solid,.chip.on,.tag.fill,.deskNav a.on,.avatar,.bell i,.atabs button.on,.seg button.on,.toast,.tabbar a.on svg){background:var(--gold);border-color:var(--gold);color:#101C3E}
html[data-theme=navy] .bar i{background:var(--gold)}
html[data-theme=navy] .hero{background:#0A1430}
html[data-theme=navy] .btn.del{border-color:#6b2f3a;color:#ff9aa2}
html[data-theme=navy] .status.ok{background:#12372c;color:#6fd3a6}
html[data-theme=navy] .status.error{background:#3a1c26;color:#ff9aa2}
html[data-theme=navy] .overlay{background:#030816b3}
</style>
<script>try{document.documentElement.dataset.theme=localStorage.getItem("nb_theme")==="white"?"white":"navy"}catch(e){document.documentElement.dataset.theme="navy"}</script></head>
<body>
<header class="top"><div class="wrap top-in">
 <a class="brand" href="#home" aria-label="Nimbar"><img src="data:image/png;base64," alt=""><b data-i18n="brand">نِمبار</b></a>
 <nav class="deskNav" id="deskNav" aria-label="main"></nav>
 <button class="bell" id="bellBtn" aria-label="الإشعارات"><svg viewBox="0 0 24 24"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 8 3 8H3s3-1 3-8"/><path d="M10.3 20a2 2 0 0 0 3.4 0"/></svg><i id="bellCount" class="hidden">0</i></button>
</div></header>

<main>
<!-- القائمة الرئيسية -->
<section class="view-home" id="v-home">
 <div class="hero"><img class="palm" src="data:image/png;base64," alt=""><div class="wrap hero-in">
  <h1 data-i18n="heroTitle">فرصتك التالية تبدأ من هنا</h1>
  <p data-i18n="heroText">ورش ومسابقات من فريق نِمبار، مختارة وواضحة التفاصيل.</p>
  <div class="go"><a class="btn light" href="#opps" data-i18n="browse">تصفّح الفرص</a><span class="count"><b id="heroCount">0</b><span data-i18n="published">فرصة منشورة</span></span></div>
  <div class="slogan" data-i18n="slogan">«من جذور الماضي، نصنع أفكار المستقبل.»</div>
 </div></div>
 <div class="wrap view" id="opps">
  <a class="pinned hidden" id="pinned" href="#home"><img id="pinnedImg" alt=""><div><b id="pinnedTitle"></b><span id="pinnedText"></span></div></a>
  <div class="view-head"><div><h2 data-i18n="oppsTitle">الفرص المتاحة</h2><p data-i18n="oppsSub">اختر ورشة أو مسابقة تناسبك.</p></div>
   <div class="search"><input id="q" data-i18n-ph="search" placeholder="ابحث عن ورشة أو مسابقة"><button class="btn" id="qClear" data-i18n="clear">مسح</button></div></div>
  <div id="filters" class="frows"></div>
  <div class="grid" id="cards"></div><div id="chans"></div>
 </div>
</section>

<!-- الأخبار -->
<section class="view-sec hidden" id="v-news"><div class="wrap view">
 <div class="view-head"><div><h2 data-i18n="newsTitle">الأخبار</h2><p data-i18n="newsSub">آخر ما نشره فريق نِمبار.</p></div></div>
 <div class="grid" id="newsCards"></div>
</div></section>

<!-- البحوثات -->
<section class="view-sec hidden" id="v-research"><div class="wrap view">
 <div class="view-head"><div><h2 data-i18n="resTitle">البحوثات</h2><p data-i18n="resSub">بحوث ودراسات منشورة عبر نِمبار.</p></div>
  <div class="search"><input id="rq" data-i18n-ph="searchRes" placeholder="ابحث بعنوان البحث أو الباحث"><button class="btn" id="rqClear" data-i18n="clear">مسح</button></div></div>
 <div class="grid" id="resCards"></div>
</div></section>

<!-- الشهادات -->
<section class="view-sec hidden" id="v-certs"><div class="wrap view"><div class="cert-box">
 <img class="mark" src="data:image/png;base64," alt="">
 <h2 data-i18n="certTitle">شهادتك</h2>
 <p data-i18n="certSub">ادخل رمز الشهادة الذي استلمته من نِمبار.</p>
