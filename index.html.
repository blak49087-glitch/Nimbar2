/* رفع صورة من المعرض إلى التخزين */
let sbc=null;
async function uploadImg(file){
 const bmp=await createImageBitmap(file),s=Math.min(1,1280/Math.max(bmp.width,bmp.height)),c=document.createElement('canvas');
 c.width=Math.round(bmp.width*s);c.height=Math.round(bmp.height*s);const g=c.getContext('2d');g.fillStyle='#fff';g.fillRect(0,0,c.width,c.height);g.drawImage(bmp,0,0,c.width,c.height);
 const blob=await new Promise(r=>c.toBlob(r,'image/jpeg',.85));
 const {slots}=await api('media.prepare',{n:1});
 if(!sbc){const {createClient}=await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.95.0/+esm');sbc=createClient(SB_URL,SB_KEY)}
 const {error}=await sbc.storage.from('nimbar-media').uploadToSignedUrl(slots[0].path,slots[0].token,blob,{contentType:'image/jpeg'});
 if(error)throw new Error('تعذر رفع الصورة');return slots[0].url}

function fld([id,l,ty,req,opt]){
 const full=['textarea','image','blocks','questions','check'].includes(ty)?'style="grid-column:1/-1"':'';let c;
 if(ty==='check')return`<label style="grid-column:1/-1;display:flex;gap:8px;align-items:center;margin:4px 0 8px"><input type="checkbox" id="f_${id}" style="width:auto"> ${l}</label>`;
 if(ty==='textarea')c=`<textarea id="f_${id}" ${req?'required':''}></textarea>`;
 else if(ty==='select')c=`<select id="f_${id}">${opt.map(([v,n])=>`<option value="${v}">${n}</option>`).join('')}</select>`;
 else if(ty==='image')c=`<input type="hidden" id="f_${id}"><div class="imgprev" id="pv_${id}"></div><div class="btnrow"><label class="btn sm">📷 اختيار من المعرض<input type="file" accept="image/*" hidden data-img="${id}"></label><button type="button" class="btn sm del" data-imgx="${id}">إزالة</button></div>`;
 else if(ty==='blocks')c=`<div id="f_${id}"></div><div class="btnrow"><button type="button" class="btn sm" data-ab="${id}|text">＋ نص</button><button type="button" class="btn sm" data-ab="${id}|img">＋ صورة</button></div>`;
 else if(ty==='questions')c=`<div id="f_${id}"></div><button type="button" class="btn sm" data-aq2="${id}">＋ سؤال</button>`;
 else c=`<input id="f_${id}" type="${ty}" ${req?'required':''} ${ty==='url'?'class="ltr" placeholder="https://"':''}>`;
 return`<div class="field" ${full}><label>${l}${req?' *':''}</label>${c}</div>`}
function setImg(id,u){$('f_'+id).value=u||'';$('pv_'+id).innerHTML=u?`<img src="${esc(u)}" alt="">`:''}
function drawQ(id){$('f_'+id).innerHTML=ST[id].map((q,i)=>`<div class="qrow"><input data-qi="${id}|${i}" value="${esc(q)}" placeholder="السؤال ${i+1}"><button type="button" class="btn sm del" data-qx="${id}|${i}">×</button></div>`).join('')}
function drawB(id){$('f_'+id).innerHTML=ST[id].map((b,i)=>`<div class="blk">${b.t==='img'?`<div class="imgprev">${b.v?`<img src="${esc(b.v)}" alt="">`:''}</div><label class="btn sm">📷 اختيار صورة<input type="file" accept="image/*" hidden data-bimg="${id}|${i}"></label>`:`<textarea data-bt="${id}|${i}" placeholder="اكتب النص…">${esc(b.v)}</textarea>`}<span class="act"><button type="button" class="btn sm" data-bm="${id}|${i}|-1">↑</button><button type="button" class="btn sm" data-bm="${id}|${i}|1">↓</button><button type="button" class="btn sm del" data-bx2="${id}|${i}">حذف</button></span></div>`).join('')}
function fillForm(K,p){K.fields.forEach(([id,,ty,,opt])=>{let v=p[id];if(id==='cover'&&!v)v=p.image_url;
 if(ty==='image')setImg(id,v);
 else if(ty==='blocks'){ST[id]=Array.isArray(v)?v.map(b=>({...b})):[];drawB(id)}
 else if(ty==='questions'){ST[id]=Array.isArray(v)&&v.length?[...v]:['',''];drawQ(id)}
 else if(ty==='check')$('f_'+id).checked=!!v;
 else if(ty==='select')$('f_'+id).value=(id==='category'&&v==='cp'?'مسابقات':v)||opt[0][0];
 else $('f_'+id).value=v||''})}
function collect(K){const p={};for(const[id,,ty]of K.fields){
 if(ty==='image')p[id]=$('f_'+id).value||null;
 else if(ty==='blocks')p[id]=ST[id].filter(b=>String(b.v).trim()).map(b=>({t:b.t,v:String(b.v).trim()}));
 else if(ty==='questions')p[id]=ST[id].map(s=>s.trim()).filter(Boolean);
 else if(ty==='check')p[id]=$('f_'+id).checked;
 else p[id]=$('f_'+id).value.trim()||null}return p}

