 const reset=()=>{editing=null;fillForm(K,{});$('f_flag').checked=true;$('f_save').textContent=K.save||'نشر'};reset();
 $('f_reset').onclick=reset;
 const af=$('af');
 af.addEventListener('input',e=>{const x=e.target.dataset;if(x.qi){const[id,i]=sp(x.qi);ST[id][i]=e.target.value}if(x.bt){const[id,i]=sp(x.bt);ST[id][i].v=e.target.value}});
 af.addEventListener('change',async e=>{const x=e.target.dataset;if(!(x.img||x.bimg))return;const f=e.target.files[0];if(!f)return;
  astat('جارٍ رفع الصورة…');try{const u=await uploadImg(f);if(x.img)setImg(x.img,u);else{const[id,i]=sp(x.bimg);ST[id][i].v=u;drawB(id)}astat('تم رفع الصورة.','ok')}catch(err){astat(err.message,'error')}e.target.value=''});
 af.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const x=b.dataset;
  if(x.imgx)setImg(x.imgx,'');
  if(x.ab){const[id,ty]=sp(x.ab);ST[id].push({t:ty,v:''});drawB(id)}
  if(x.aq2){ST[x.aq2].push('');drawQ(x.aq2)}
  if(x.qx){const[id,i]=sp(x.qx);ST[id].splice(+i,1);if(!ST[id].length)ST[id].push('');drawQ(id)}
  if(x.bx2){const[id,i]=sp(x.bx2);ST[id].splice(+i,1);drawB(id)}
  if(x.bm){const[id,i,d]=sp(x.bm),j=+i+ +d,a=ST[id];if(j>=0&&j<a.length){[a[i],a[j]]=[a[j],a[i]];drawB(id)}}});
 af.onsubmit=async e=>{e.preventDefault();const payload=collect(K);
  for(const[id,,ty]of K.fields)if(ty==='url'&&payload[id]&&!/^https?:\/\//i.test(payload[id]))return astat('الرابط لازم يبدأ بـ https://','error');
  try{await api(k+'.save',{id:editing,payload,flag:$('f_flag').checked});const was=editing;reset();astat(was?'تم حفظ التعديلات.':'تم النشر.','ok');await loadRows(k);loadFeed()}catch(err){astat(err.message,'error')}};
