/* ----- الشهادات: رفع + قراءة الاسم تلقائياً ----- */
const AL='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
function genCode(){const a=new Uint8Array(10);crypto.getRandomValues(a);return Array.from(a,x=>AL[x%32]).join('')}
const fmtCode=c=>c.replace(/^(.{5})(.{5})$/,'$1-$2');
const loadScript=src=>new Promise((res,rej)=>{const s=document.createElement('script');s.src=src;s.onload=res;s.onerror=rej;document.head.appendChild(s)});
let worker=null;
async function getWorker(){if(worker)return worker;await loadScript('https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js');worker=await Tesseract.createWorker('ara+eng');return worker}
async function prepImage(file){
 const bmp=await createImageBitmap(file),s=Math.min(1,2200/Math.max(bmp.width,bmp.height));
 const c=document.createElement('canvas');c.width=Math.round(bmp.width*s);c.height=Math.round(bmp.height*s);
 const g=c.getContext('2d');g.fillStyle='#fff';g.fillRect(0,0,c.width,c.height);g.drawImage(bmp,0,0,c.width,c.height);
 return{canvas:c,blob:await new Promise(r=>c.toBlob(r,'image/jpeg',.88))};
}
const STOP=/(شهاد|شكر|تقدير|تمنح|تُمنح|يمنح|هذه|بعنوان|ورش|مسابق|دورة|برنامج|نمبار|نِمبار|فريق|التاريخ|توقيع|المدير|رئيس|مشارك|حضور|إتمام|اتمام|certificate|nimbar|appreciation|date|signature|workshop|presented|awarded|participation|completion)/i;
const INTRO=/(إلى|الى|للسيد|السيد|السيدة|الطالب|الطالبة|يشهد|منحت|to |presented|awarded)/i;
function pickName(data){
 let lines=(data.lines&&data.lines.length?data.lines:(data.text||'').split('\n').map(x=>({text:x,bbox:{y0:0,y1:20},confidence:60})));
 const clean=l=>l.text.replace(/[^؀-ۿA-Za-z\s]/g,' ').replace(/\s+/g,' ').trim();
 let best=null;
 lines.forEach((l,i)=>{
  const txt=clean(l),words=txt.split(' ').filter(w=>w.length>1);
  if(words.length<2||words.length>5||txt.length<6||STOP.test(txt))return;
  const h=(l.bbox?.y1||20)-(l.bbox?.y0||0);let score=h*(l.confidence>55?1:.6);
  if(i>0&&INTRO.test(lines[i-1].text))score*=2.2;
  if(!best||score>best.score)best={name:words.join(' '),score,conf:l.confidence||0};
 });
 return best||{name:'',conf:0};
}
let batch=[];
function certsView(){
 $('apanel').innerHTML=`<div id="astat" class="status hidden"></div>
 <label class="drop" id="dz"><b>اختر صور الشهادات (كلها دفعة وحدة)</b><p style="color:var(--muted)">النظام يقرأ الاسم من كل صورة ويعطي كل شهادة رمزاً خاصاً. راجع الأسماء قبل الحفظ.</p><input type="file" id="cfiles" accept="image/*" multiple class="hidden"></label>
 <div id="batchBox" class="hidden"><div class="bar"><i id="bprog"></i></div><div class="alist" id="brows"></div><div class="btnrow" style="margin-top:14px"><button class="btn solid" id="bsave">حفظ الشهادات</button><button class="btn" id="bclear">إلغاء الدفعة</button></div></div>
 <h3 style="margin:30px 0 4px;font-size:18px">الشهادات المحفوظة</h3><div id="pairsBox"></div><div class="alist" id="clist"></div>`;
 $('cfiles').onchange=e=>startBatch([...e.target.files]);
 $('bclear').onclick=()=>{batch=[];$('batchBox').classList.add('hidden')};
 $('bsave').onclick=saveBatch;loadCerts();
}
async function startBatch(files){
 if(!files.length)return;batch=[];$('batchBox').classList.remove('hidden');$('bprog').style.width='0';
 files.forEach(f=>batch.push({file:f,name:'',code:genCode(),state:'wait',url:URL.createObjectURL(f)}));renderBatch();
 let w;try{w=await getWorker()}catch{astat('تعذر تحميل قارئ الصور. اكتب الأسماء يدوياً.','error');batch.forEach(b=>b.state='manual');renderBatch();return}
 for(let i=0;i<batch.length;i++){const b=batch[i];b.state='read';renderBatch();
  try{const p=await prepImage(b.file);b.blob=p.blob;const r=await w.recognize(p.canvas);const pk=pickName(r.data);b.name=pk.name;b.low=!pk.name||pk.conf<70;b.state='done'}
  catch{b.state='manual';try{b.blob=b.blob||(await prepImage(b.file)).blob}catch{}}
  $('bprog').style.width=Math.round((i+1)/batch.length*100)+'%';renderBatch()}
}
function renderBatch(){
 $('brows').innerHTML=batch.map((b,i)=>`<div class="crow ${(b.low&&b.state==='done')||(!b.name&&b.state!=='wait'&&b.state!=='read')?'warn':''}"><img src="${b.url}" alt=""><div><input data-bi="${i}" value="${esc(b.name)}" placeholder="${b.state==='read'?'جارٍ قراءة الاسم…':'اكتب الاسم'}"><div class="code">${fmtCode(b.code)} ${b.low&&b.state==='done'?'<span style="color:var(--bad);font-family:inherit">راجع الاسم</span>':''}<button class="btn sm del" data-bx="${i}" style="margin-inline-start:auto">إزالة</button></div></div></div>`).join('');
 $('brows').oninput=e=>{const i=e.target.dataset.bi;if(i!==undefined){batch[i].name=e.target.value;batch[i].low=false}};
 $('brows').onclick=e=>{const x=e.target.closest('[data-bx]');if(x){batch.splice(+x.dataset.bx,1);renderBatch()}};
}
async function saveBatch(){
 if(!batch.length)return;
 if(batch.some(b=>b.state==='read'))return astat('انتظر لين تنتهي قراءة الصور.','error');
 if(batch.some(b=>b.name.trim().length<2))return astat('في شهادات بدون اسم. اكتب الاسم لكل شهادة.','error');
 const btn=$('bsave');btn.disabled=true;btn.textContent='جارٍ الرفع…';
 try{
  const {slots}=await api('cert.prepare',{n:batch.length});
  const {createClient}=await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.95.0/+esm');
  const sb=createClient(SB_URL,SB_KEY);
  for(let i=0;i<batch.length;i++){const b=batch[i];if(!b.blob)b.blob=(await prepImage(b.file)).blob;
   const {error}=await sb.storage.from(BUCKET).uploadToSignedUrl(slots[i].path,slots[i].token,b.blob,{contentType:'image/jpeg'});if(error)throw new Error('تعذر رفع صورة: '+b.name);
   $('bprog').style.width=Math.round((i+1)/batch.length*100)+'%'}
  const send=()=>api('cert.save',{items:batch.map((b,i)=>({name:b.name,code:b.code,path:slots[i].path}))});
  try{await send()}catch(e){if(e.message==='code_conflict'){batch.forEach(b=>b.code=genCode());await send()}else throw e}
  const n=batch.length;batch=[];$('batchBox').classList.add('hidden');astat(`تم حفظ ${n} شهادة. انسخ قائمة (الاسم: الرمز) من الأسفل.`,'ok');loadCerts();
 }catch(err){astat(err.message,'error')}
 finally{btn.disabled=false;btn.textContent='حفظ الشهادات'}
}
async function loadCerts(){
 try{const d=await api('cert.list');rows.certs=d.data;
  const pairs=d.data.map(c=>`${c.name}: ${fmtCode(c.code)}`).join('\n');
  $('pairsBox').innerHTML=d.data.length?`<p style="color:var(--muted);margin-bottom:8px">القائمة جاهزة للنسخ (الاسم: الرمز):</p><textarea class="pairs" readonly id="pairs">${esc(pairs)}</textarea><div class="btnrow" style="margin-top:8px"><button class="btn sm solid" id="copyAll">نسخ القائمة</button></div>`:'';
  $('clist').innerHTML=d.data.length?d.data.map(c=>`<div class="crow"><img src="${esc(c.url||'')}" alt=""><div><b>${esc(c.name)}</b><div class="code">${fmtCode(c.code)}<button class="btn sm" data-cc="${esc(c.code)}">نسخ الرمز</button><a class="btn sm" target="_blank" rel="noopener" href="${esc(c.url||'#')}">عرض</a><button class="btn sm del" data-cd="${esc(c.id)}">حذف</button></div></div></div>`).join(''):'<div class="empty">ما في شهادات محفوظة بعد.</div>';
  if($('copyAll'))$('copyAll').onclick=()=>navigator.clipboard.writeText(pairs).then(()=>toast('تم نسخ القائمة'));
  $('clist').onclick=async e=>{const cc=e.target.closest('[data-cc]'),cd=e.target.closest('[data-cd]');
   if(cc)navigator.clipboard.writeText(fmtCode(cc.dataset.cc)).then(()=>toast('تم نسخ الرمز'));
   if(cd&&confirm('حذف هذه الشهادة نهائياً؟')){try{await api('cert.delete',{id:cd.dataset.cd});loadCerts()}catch(err){astat(err.message,'error')}}};
 }catch(err){$('clist').innerHTML=`<div class="status error">${esc(err.message)}</div>`}
}

